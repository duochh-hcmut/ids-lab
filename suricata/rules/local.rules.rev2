# Rev 2, kept only for run E7. These rules alert on any SYN and on /admin.
# SID 1000002 here is the old admin rule, not the rev 3 traversal rule.

alert tcp any any -> 172.20.0.20 any (msg:"LAB DETECT: Nmap Stealth SYN Scan Detected"; flags:S; sid:1000001; rev:2;)

alert http any any -> 172.20.0.20 80 (msg:"LAB DETECT: Suspicious Admin Path Traversal Attempt"; flow:to_server; http.uri; content:"/admin"; sid:1000002; rev:2;)
